<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lago Ange Florent – Vidéo de campagne – ESBTP Yopougon</title>
<meta name="description" content="Vidéo de campagne de Lago Ange Florent, candidat à la présidence de l’ESBTP Yopougon.">
<meta name="theme-color" content="#2f3514">
<meta property="og:title" content="Lago Ange Florent – Vidéo de campagne">
<meta property="og:description" content="Unis dans nos ambitions, engagés pour notre avenir.">
<meta property="og:image" content="images/lago-chantier.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --olive:#4b5320; --olive-deep:#2f3514; --jaune:#ffc20e; --orange:#f26a1b; --blanc:#fbfaf4; --noir:#161616;
  --titre:"Big Shoulders Display","Impact","Arial Narrow",sans-serif;
  --texte:"Barlow","Segoe UI",system-ui,sans-serif;
  --bande:repeating-linear-gradient(-45deg,var(--jaune) 0 20px,var(--noir) 20px 40px);
  --ease:cubic-bezier(.2,.8,.2,1);
}
*{box-sizing:border-box;margin:0}
html,body{height:100%;background:#000;overflow:hidden;font-family:var(--texte);color:var(--blanc)}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--orange);outline-offset:2px}

#frame{position:fixed;inset:0 0 64px 0;overflow:hidden}
#stage{position:absolute;left:0;top:0;width:1080px;height:1920px;transform-origin:0 0;background:var(--olive-deep);overflow:hidden}

/* Éléments communs */
.scene{position:absolute;inset:0;visibility:hidden;overflow:hidden;background:var(--olive-deep)}
.scene.on{visibility:visible}
.grid{position:absolute;inset:0;background:
  repeating-linear-gradient(90deg,transparent 0 107px,rgba(255,255,255,.05) 107px 108px),
  repeating-linear-gradient(0deg,transparent 0 107px,rgba(255,255,255,.05) 107px 108px)}
.hz{position:absolute;left:0;right:0;height:70px;background:var(--bande)}
.hz.t{top:0}.hz.b{bottom:0}
.on .hz.t{animation:slideR .8s var(--ease) both}
.on .hz.b{animation:slideL .8s .1s var(--ease) both}
.mask{overflow:hidden;padding-bottom:.04em}
.on .mask>*{animation:up .85s var(--ease) both;animation-delay:var(--d,0s)}

/* Scène 0 : titre */
.s0 .c0{position:absolute;left:90px;right:90px;top:620px}
.big{font:900 360px/.88 var(--titre);text-transform:uppercase}
.mid{font:900 190px/.95 var(--titre);color:var(--jaune);text-transform:uppercase}
.bar{height:14px;background:var(--orange);margin:50px 0 40px;transform-origin:left}
.on .bar{animation:grow .8s 1.2s var(--ease) both}
.sub{font:500 58px/1.2 var(--texte);color:#e9e7d2}
.on .sub{animation:fondu .8s 1.6s both}

/* Scène 1 : le candidat */
.ph1{position:absolute;left:150px;top:130px;width:780px;height:900px}
.ph1::before{content:"";position:absolute;inset:0;background:var(--jaune);transform:translate(24px,24px)}
.on .ph1::before{animation:cale .9s .3s var(--ease) both}
.fr{position:absolute;inset:0;border:12px solid var(--blanc);overflow:hidden;background:var(--olive)}
.on .fr{animation:rideau 1.1s .1s var(--ease) both}
.fr img{width:100%;height:100%;object-fit:cover}
.on .fr img{animation:zoom 6s linear both}
.nm{position:absolute;left:90px;top:1090px}
.nm .mask>*{font:900 190px/.88 var(--titre);text-transform:uppercase}
.nm .y{color:var(--jaune)}
.tag{position:absolute;left:90px;right:90px;top:1660px;font:500 52px/1.25 var(--texte);color:#e9e7d2}
.on .tag{animation:fondu .8s 1.9s both}

/* Scène 2 : vision */
.s2{background:var(--olive)}
.vt{position:absolute;left:90px;top:110px;font:900 170px/.95 var(--titre);color:var(--jaune);text-transform:uppercase}
.vs{position:absolute;left:90px;top:340px;width:900px;font:600 70px/1.15 var(--texte)}
.on .vs{animation:fondu .8s .5s both}
.chips{position:absolute;left:90px;top:520px}
.chip{display:block;width:fit-content;padding:0 38px;margin-bottom:22px;font:900 118px/1.15 var(--titre);text-transform:uppercase}
.chip.c1{background:var(--jaune);color:var(--noir)}
.chip.c2{background:var(--orange);color:var(--noir)}
.chip.c3{background:var(--blanc);color:var(--noir)}
.chip.c4{background:var(--noir);color:var(--jaune)}
.on .chip{animation:chip .7s var(--ease) both;animation-delay:calc(1.2s + var(--k)*.55s)}
.cap{position:absolute;left:90px;width:900px;top:1190px;font:500 52px/1.25 var(--texte)}
.on .cap{animation:fondu .8s 3.7s both}
.ph2{position:absolute;left:0;right:0;bottom:0;height:520px;overflow:hidden;
  -webkit-mask-image:linear-gradient(to bottom,transparent,#000 35%);mask-image:linear-gradient(to bottom,transparent,#000 35%)}
.ph2 img{width:100%;height:100%;object-fit:cover;object-position:50% 33%}
.on .ph2{animation:montee 1s .3s var(--ease) both}

/* Scènes 3 à 8 : les axes */
.axe.alt{background:var(--olive)}
.ghost{position:absolute;right:-70px;top:230px;font:900 1350px/1 var(--titre);color:transparent;-webkit-text-stroke:4px rgba(255,255,255,.14)}
.on .ghost{animation:fantome 1s var(--ease) both}
.prog{position:absolute;left:90px;right:90px;top:130px;display:flex;gap:14px}
.prog i{flex:1;height:14px;background:rgba(255,255,255,.22);position:relative;overflow:hidden}
.prog i.done::after,.prog i.cur::after{content:"";position:absolute;inset:0;background:var(--jaune);transform-origin:left}
.on .prog i.cur::after{animation:grow 2.8s linear both}
.numblk{position:absolute;left:90px;top:260px;width:250px;height:250px;background:var(--jaune);border:12px solid var(--noir);display:grid;place-items:center;font:900 190px/1 var(--titre);color:var(--noir)}
.axe.alt .numblk{background:var(--orange)}
.on .numblk{animation:pop .5s .15s var(--ease) both}
.axe h2{position:absolute;left:90px;top:610px;width:900px;font:900 132px/.95 var(--titre);text-transform:uppercase}
.w{display:inline-block;overflow:hidden;vertical-align:top;margin-right:.22em;padding-bottom:.05em}
.w>span{display:inline-block}
.on .w>span{animation:up .7s var(--ease) both;animation-delay:calc(.4s + var(--i)*.09s)}
.obj{position:absolute;left:90px;top:1400px;width:900px;border-left:14px solid var(--jaune);padding-left:36px;font:500 62px/1.25 var(--texte)}
.obj b{color:var(--jaune);font-weight:600}
.on .obj{animation:fondu .8s 1.3s both}

/* Scène 9 : devise */
.pa,.pb{position:absolute;width:450px;height:650px;border:10px solid var(--blanc);overflow:hidden;background:var(--olive)}
.pa{left:80px;top:170px;transform:rotate(-4deg)}
.pb{left:550px;top:250px;transform:rotate(3deg)}
.pa img,.pb img{width:100%;height:100%;object-fit:cover}
.pa img{object-position:50% 25%}.pb img{object-position:50% 25%}
.on .pa{animation:entree-a 1s .1s var(--ease) both}
.on .pb{animation:entree-b 1s .3s var(--ease) both}
.dv{position:absolute;left:90px;width:900px;top:980px}
.dv .mask>*{font:900 118px/1 var(--titre);text-transform:uppercase}
.dv .a{color:var(--jaune)}
.dv .guil{font:900 200px/.6 var(--titre);color:var(--orange);height:110px}

/* Scène 10 : final */
.s10{background:var(--jaune);color:var(--noir)}
.vz,.lg{position:absolute;left:0;right:0;text-align:center;font-family:var(--titre);font-weight:900;text-transform:uppercase}
.vz{top:130px;font-size:300px;line-height:.85}
.lg{top:390px;font-size:470px;line-height:.85;color:var(--noir)}
.on .lg{animation:pop2 .5s .9s var(--ease) both}
.pf{position:absolute;left:220px;top:930px;width:640px;height:730px;border:12px solid var(--noir);box-shadow:18px 18px 0 var(--orange);overflow:hidden;background:var(--olive)}
.pf img{width:100%;height:100%;object-fit:cover;object-position:50% 22%}
.on .pf{animation:rideau 1s 1.5s var(--ease) both}
.es{position:absolute;left:0;right:0;top:1710px;text-align:center;font:900 84px/1 var(--titre);text-transform:uppercase}
.on .es{animation:fondu .8s 2.3s both}

/* Transition : rideau de chantier */
.wipe{position:absolute;inset:0;z-index:50;pointer-events:none;transform:translateX(-110%);background:var(--jaune)}
.wipe::after{content:"";position:absolute;top:0;right:0;width:110px;height:100%;background:var(--bande)}
.wipe.go{animation:wipe .75s cubic-bezier(.7,0,.3,1) both}

@keyframes up{from{transform:translateY(112%)}to{transform:none}}
@keyframes fondu{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes grow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes slideR{from{transform:translateX(-100%)}to{transform:none}}
@keyframes slideL{from{transform:translateX(100%)}to{transform:none}}
@keyframes rideau{from{clip-path:inset(100% 0 0 0)}to{clip-path:inset(0)}}
@keyframes cale{from{transform:translate(-120%,24px);opacity:0}to{transform:translate(24px,24px);opacity:1}}
@keyframes zoom{from{transform:scale(1)}to{transform:scale(1.14)}}
@keyframes chip{from{transform:translateX(-115%)}to{transform:none}}
@keyframes montee{from{opacity:0;transform:translateY(120px)}to{opacity:1;transform:none}}
@keyframes fantome{from{opacity:0;transform:translateX(120px)}to{opacity:1;transform:none}}
@keyframes pop{from{opacity:0;transform:scale(2.4) rotate(-14deg)}to{opacity:1;transform:none}}
@keyframes pop2{from{opacity:0;transform:scale(2.2) rotate(-6deg)}to{opacity:1;transform:none}}
@keyframes entree-a{from{opacity:0;transform:translateY(160%) rotate(-14deg)}to{opacity:1;transform:rotate(-4deg)}}
@keyframes entree-b{from{opacity:0;transform:translateY(160%) rotate(12deg)}to{opacity:1;transform:rotate(3deg)}}
@keyframes wipe{from{transform:translateX(-110%)}to{transform:translateX(110%)}}

.paused .scene *,.paused .scene *::before,.paused .scene *::after,.paused .wipe{animation-play-state:paused!important}

/* Écran de départ */
#start{position:absolute;inset:0;z-index:60;background:var(--olive-deep);display:grid;place-items:center;text-align:center;padding:1.5rem}
#start.off{display:none}
#start .box{max-width:360px;display:grid;gap:1rem;justify-items:center}
#start img{width:180px;height:240px;object-fit:cover;object-position:50% 22%;border:5px solid var(--blanc);box-shadow:10px 10px 0 var(--jaune)}
#start h1{font:900 clamp(2.6rem,10vw,3.6rem)/.95 var(--titre);text-transform:uppercase;margin-top:.8rem}
#start p{color:#e9e7d2}
#go{background:var(--jaune);color:var(--noir);border:3px solid var(--jaune);font-weight:600;font-size:1.15rem;padding:.9rem 1.6rem;transition:transform .2s var(--ease),box-shadow .2s var(--ease)}
#go:hover{transform:translate(-3px,-3px);box-shadow:6px 6px 0 var(--orange)}
#start small{color:#b9b79f}

/* Commandes */
#ui{position:fixed;left:0;right:0;bottom:0;height:64px;background:var(--noir);border-top:3px solid var(--jaune);display:flex;align-items:center;gap:.6rem;padding:0 .8rem}
#ui button{background:transparent;color:var(--blanc);border:2px solid #4a4a44;min-width:44px;height:40px;padding:0 .7rem;font-size:.95rem}
#ui button:hover{background:var(--jaune);color:var(--noir);border-color:var(--jaune)}
#pg{flex:1;height:8px;background:#3a3a35;position:relative;overflow:hidden}
#pg i{position:absolute;inset:0;background:var(--orange);transform-origin:left;transform:scaleX(0)}

@media(prefers-reduced-motion:reduce){
  .on .bar,.on .w>span,.on .mask>*{animation-duration:.01s!important}
}
</style>
</head>
<body>

<div id="frame">
  <div id="stage" aria-label="Vidéo de campagne de Lago Ange Florent">

    <!-- 0 : titre -->
    <section class="scene s0" data-s="0" data-e="4" data-thud="0.9">
      <div class="grid"></div>
      <div class="hz t"></div><div class="hz b"></div>
      <div class="c0">
        <div class="mask"><div class="big" style="--d:.3s">ESBTP</div></div>
        <div class="mask"><div class="mid" style="--d:.55s">Yopougon</div></div>
        <div class="bar"></div>
        <p class="sub">Candidature à la présidence</p>
      </div>
    </section>

    <!-- 1 : le candidat -->
    <section class="scene s1" data-s="4" data-e="9.5" data-thud="1.1">
      <div class="grid"></div>
      <div class="ph1"><div class="fr"><img data-img="lago-chantier" src="images/lago-chantier.jpg" alt=""></div></div>
      <div class="nm">
        <div class="mask"><div style="--d:1s">Lago</div></div>
        <div class="mask"><div style="--d:1.15s">Ange</div></div>
        <div class="mask"><div class="y" style="--d:1.3s">Florent</div></div>
      </div>
      <p class="tag">Candidat à la présidence de l’ESBTP Yopougon</p>
    </section>

    <!-- 2 : vision -->
    <section class="scene s2" data-s="9.5" data-e="15" data-thud="1.2,1.75,2.3,2.85">
      <div class="grid"></div>
      <div class="vt mask"><div style="--d:.1s">Ma vision</div></div>
      <p class="vs">Une école où chaque étudiant se sent :</p>
      <div class="chips">
        <span class="chip c1" style="--k:0">Écouté</span>
        <span class="chip c2" style="--k:1">Respecté</span>
        <span class="chip c3" style="--k:2">Accompagné</span>
        <span class="chip c4" style="--k:3">Valorisé</span>
      </div>
      <p class="cap">Une représentation estudiantine dynamique, qui défend vos intérêts et favorise votre réussite.</p>
      <div class="ph2"><img data-img="lago-costume" src="images/lago-costume.jpg" alt=""></div>
    </section>

    <!-- 3 à 8 : axes (générés) -->

    <!-- 9 : devise -->
    <section class="scene s9" data-s="33" data-e="37.5" data-thud="0.4">
      <div class="grid"></div>
      <div class="pa"><img data-img="lago-costume" src="images/lago-costume.jpg" alt=""></div>
      <div class="pb"><img data-img="lago-chantier" src="images/lago-chantier.jpg" alt=""></div>
      <div class="dv">
        <div class="mask"><div class="guil" style="--d:.5s">«</div></div>
        <div class="mask"><div class="a" style="--d:.7s">Unis dans nos ambitions,</div></div>
        <div class="mask"><div style="--d:1.6s">engagés pour notre avenir.</div></div>
      </div>
      <div class="hz b"></div>
    </section>

    <!-- 10 : final -->
    <section class="scene s10" data-s="37.5" data-e="999" data-thud="0.5,1.3">
      <div class="hz t"></div>
      <div class="vz mask"><div style="--d:.2s">Votez</div></div>
      <div class="lg">Lago</div>
      <div class="pf"><img data-img="lago-chantier" src="images/lago-chantier.jpg" alt=""></div>
      <p class="es">ESBTP Yopougon</p>
      <div class="hz b"></div>
    </section>

    <div class="wipe" id="wipe"></div>
  </div>

  <div id="start">
    <div class="box">
      <img data-img="lago-chantier" src="images/lago-chantier.jpg" alt="">
      <h1>Lago Ange<br>Florent</h1>
      <p>Candidat à la présidence de l’ESBTP Yopougon</p>
      <button id="go">▶ Lancer la vidéo</button>
      <small>Active le son pour la musique</small>
    </div>
  </div>
</div>

<audio id="mus" preload="auto" src="data:audio/mpeg;base64,"></audio>

<div id="ui">
  <button id="pp" aria-label="Pause">❚❚</button>
  <button id="rp" aria-label="Revoir depuis le début">↻</button>
  <div id="pg" aria-hidden="true"><i></i></div>
  <button id="sd" aria-label="Couper le son">Son</button>
</div>

<script>
(function(){
  var IMG={"lago-chantier": "data:image/jpeg;base64,", "lago-costume": "data:image/jpeg;base64,"};
  [].forEach.call(document.querySelectorAll('img[data-img]'),function(i){i.src=IMG[i.dataset.img]});
  var AXES=[
    ['Amélioration des conditions d’études','permettre à chaque étudiant d’étudier dans de meilleures conditions.'],
    ['Accompagnement académique et réussite des étudiants','améliorer les résultats et favoriser la réussite.'],
    ['Sport, culture et loisirs','renforcer la cohésion entre les étudiants.'],
    ['Insertion professionnelle et stages','rapprocher les étudiants du monde de l’emploi.'],
    ['Communication et transparence','créer une présidence proche des étudiants.'],
    ['Solidarité et entraide estudiantine','ne laisser aucun étudiant de côté.']
  ];
  var stage=document.getElementById('stage'), anchor=document.getElementById('wipe');
  var AX_START=15, AX_LEN=3;

  // Génération des 6 scènes « axes »
  AXES.forEach(function(a,i){
    var n=i+1, s=AX_START+i*AX_LEN, e=s+AX_LEN;
    var words=a[0].split(' ').map(function(w,k){return '<span class="w"><span style="--i:'+k+'">'+w+'</span></span>'}).join(' ');
    var pills='';
    for(var p=1;p<=6;p++) pills+='<i class="'+(p<n?'done':p===n?'cur':'')+'"></i>';
    var sec=document.createElement('section');
    sec.className='scene axe'+(i%2?' alt':'');
    sec.dataset.s=s; sec.dataset.e=e; sec.dataset.thud='0.3';
    sec.innerHTML='<div class="grid"></div><div class="ghost" aria-hidden="true">'+n+'</div>'+
      '<div class="prog" aria-hidden="true">'+pills+'</div><div class="numblk">'+n+'</div>'+
      '<h2>'+words+'</h2><p class="obj"><b>Objectif :</b> '+a[1]+'</p><div class="hz b"></div>';
    stage.insertBefore(sec,anchor);
  });
  // Ordre correct : scène devise et finale après les axes
  var s9=document.querySelector('.s9'), s10=document.querySelector('.s10');
  stage.insertBefore(s9,anchor); stage.insertBefore(s10,anchor);

  var scenes=[].slice.call(document.querySelectorAll('.scene')).map(function(el){
    return {el:el,s:+el.dataset.s,e:+el.dataset.e,on:false,
      thud:(el.dataset.thud||'').split(',').filter(Boolean).map(Number)};
  }).sort(function(a,b){return a.s-b.s});
  var TOTAL=42;

  /* ---------- Mise à l’échelle 9:16 ---------- */
  var frame=document.getElementById('frame'), K=1;
  function fit(){
    var w=frame.clientWidth,h=frame.clientHeight,k=Math.min(w/1080,h/1920); K=k;
    stage.style.transform='translate('+((w-1080*k)/2)+'px,'+((h-1920*k)/2)+'px) scale('+k+')';
  }
  addEventListener('resize',fit); fit();

  /* ---------- Horloge ---------- */
  var t=0, playing=false, last=performance.now(), fired={}, started=false;
  var bar=document.querySelector('#pg i'), pp=document.getElementById('pp');
  function wipeGo(){ anchor.classList.remove('go'); void anchor.offsetWidth; anchor.classList.add('go'); }
  function render(){
    scenes.forEach(function(sc,idx){
      var on=t>=sc.s && t<sc.e;
      if(on!==sc.on){ sc.on=on; sc.el.classList.toggle('on',on); }
      if(idx>0 && t>=sc.s-.375 && !fired['w'+idx]){ fired['w'+idx]=1; if(playing) wipeGo(); }
    });
    bar.style.transform='scaleX('+Math.min(t/TOTAL,1)+')';
  }
  function frameLoop(now){
    var dt=Math.min((now-last)/1000,.1); last=now;
    if(playing){
      t+=dt;
      if(mus.readyState>=2 && Math.abs(mus.currentTime-t)>.35){ try{ mus.currentTime=t; }catch(e){} }
      if(t>=TOTAL){ t=TOTAL; setPlaying(false,true); }
    }
    render(); requestAnimationFrame(frameLoop);
  }
  function setPlaying(p,fin){
    playing=p; stage.classList.toggle('paused',!p);
    pp.textContent=p?'❚❚':'▶'; pp.setAttribute('aria-label',p?'Pause':'Lecture');
    if(p){ var pr=mus.play(); if(pr&&pr.catch) pr.catch(function(){}); } else { mus.pause(); }
  }
  function reset(){
    t=0; fired={}; scenes.forEach(function(sc){sc.on=false;sc.el.classList.remove('on')});
    anchor.classList.remove('go');
    try{ mus.currentTime=0; }catch(e){}
    mus.muted=muted;
  }

  /* ---------- Musique (piste audio intégrée) ---------- */
  var mus=document.getElementById('mus'), muted=false;
  mus.volume=1;

  /* ---------- Commandes ---------- */
  var startEl=document.getElementById('start'), sd=document.getElementById('sd');
  function begin(){
    startEl.classList.add('off'); started=true; setPlaying(true);
  }
  document.getElementById('go').addEventListener('click',begin);
  pp.addEventListener('click',function(){
    if(!started){ begin(); return; }
    if(t>=TOTAL){ reset(); setPlaying(true); return; }
    setPlaying(!playing);
  });
  document.getElementById('rp').addEventListener('click',function(){
    if(!started){ begin(); return; }
    reset(); setPlaying(true);
  });
  sd.addEventListener('click',function(){
    muted=!muted; sd.textContent=muted?'Muet':'Son';
    sd.setAttribute('aria-label',muted?'Remettre le son':'Couper le son');
    mus.muted=muted;
  });
  addEventListener('keydown',function(e){ if(e.code==='Space'){ e.preventDefault(); pp.click(); } });
  document.addEventListener('visibilitychange',function(){ if(document.hidden && playing) setPlaying(false); });

  /* ---------- Ajustement des gros titres (si la police tarde ou manque) ---------- */
  function natural(el){
    el.style.whiteSpace='nowrap';
    var r=document.createRange(); r.selectNodeContents(el);
    return r.getBoundingClientRect().width/K;
  }
  function shrink(el,max){
    var w=natural(el);
    if(w>max) el.style.fontSize=(parseFloat(getComputedStyle(el).fontSize)*max/w*.97)+'px';
  }
  function fitAll(){
    [['.big',900],['.mid',900],['.nm .mask>div',900],['.lg',960],['.vz>div',960],['.chip',824]].forEach(function(c){
      [].forEach.call(document.querySelectorAll(c[0]),function(el){shrink(el,c[1])});
    });
    [].forEach.call(document.querySelectorAll('.axe h2'),function(h2){
      var m=0; [].forEach.call(h2.querySelectorAll('.w>span'),function(sp){ m=Math.max(m,natural(sp)); });
      if(m>880) h2.style.fontSize=(parseFloat(getComputedStyle(h2).fontSize)*880/m)+'px';
    });
  }

  render();
  (document.fonts&&document.fonts.ready?document.fonts.ready:Promise.resolve()).then(function(){
    fit(); fitAll(); requestAnimationFrame(frameLoop);
  });
})();
</script>
</body>
</html>
